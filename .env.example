# PostgreSQL connection. Use separate databases for development, staging, and production.
DATABASE_URL="postgresql://banana:password@localhost:5432/banana_crunch?schema=public"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_SETUP_TOKEN="replace-with-a-one-time-random-token-of-at-least-32-characters"

# Razorpay test credentials only. Never expose RAZORPAY_KEY_SECRET in NEXT_PUBLIC variables.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_me"
RAZORPAY_WEBHOOK_SECRET="replace_me"

# Optional integrations
RESEND_API_KEY=""
ORDER_EMAIL_FROM="orders@example.com"
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
IMAGE_STORAGE_URL=""

# Store defaults
STORE_CURRENCY="INR"
COD_ENABLED="false"
